        disponibilidad_valida_alt --> disponibilidad_servicio
        disponibilidad_publicar(["Copiar y compartir el enlace guardado — Compartir por mensaje,<br/>email o redes. Al renombrar, los enlaces anteriores siguen como<br/>alias. Cerrar reservas no cancela turnos existentes."])
        disponibilidad_entrar --> disponibilidad_servicio
        disponibilidad_servicio --> disponibilidad_profesional
        disponibilidad_profesional --> disponibilidad_reglas
        disponibilidad_reglas --> disponibilidad_slug
        disponibilidad_slug --> disponibilidad_activar
        disponibilidad_activar --> disponibilidad_valida
        disponibilidad_valida -->|Sí| disponibilidad_publicar
    end
