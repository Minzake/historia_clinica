%% Diagrama funcional del sistema implementado en develop.
%% Podología y odontología están instaladas; acceso independiente por especialidad.
%% Las líneas punteadas enlazan módulos relacionados; las sólidas representan continuidad.
flowchart TB
    SISTEMA(["Entrada al sistema"])
    SISTEMA -->|Acceso o registro| acceso_entrada
    SISTEMA -->|Enlace público| reservas_enlace
    subgraph ACCESO["01 · Acceso y cuentas"]
        direction TB
        acceso_entrada(["Abrir la aplicación — Entrar por Inicio o por un enlace de<br/>reserva."])
        acceso_conexion{"¿Está configurada la conexión?"}
        acceso_conexion_alt["Mostrar configuración inicial. El sistema no habilita el acceso a<br/>datos hasta conectar Supabase."]
        acceso_conexion -->|No| acceso_conexion_alt
        acceso_opcion["Elegir forma de acceso — Iniciar sesión, crear cuenta de<br/>paciente, recuperar contraseña o aceptar una invitación."]
        acceso_registro["Si es una cuenta nueva: registrarse — Nombre, DNI, email y<br/>contraseña de al menos 12 caracteres con confirmación. Celular<br/>opcional. Validar datos y enviar verificación."]
        acceso_credenciales["Ingresar o recuperar el acceso — Login: email y contraseña.<br/>Recuperación: solicitar enlace, abrirlo y definir una nueva<br/>contraseña."]
        acceso_sesion{"¿Sesión válida y correo verificado?"}
        acceso_sesion_alt["Corregir el acceso o verificar el correo antes de continuar."]
        acceso_sesion -->|No| acceso_sesion_alt
        acceso_sesion_alt --> acceso_credenciales
        acceso_destino(["Resolver destino según acceso — Miembro activo de un consultorio<br/>→ espacio de trabajo. Sin membresía → portal del paciente."])
        acceso_entrada --> acceso_conexion
        acceso_conexion -->|Sí| acceso_opcion
        acceso_opcion --> acceso_registro
        acceso_registro --> acceso_credenciales
        acceso_credenciales --> acceso_sesion
        acceso_sesion -->|Sí| acceso_destino
    end
    subgraph PERMISOS["02 · Consultorios, roles y permisos"]
        direction TB
        permisos_membresias(["Cargar membresías activas — Identificar los consultorios a los<br/>que pertenece la cuenta."])
        permisos_miembro{"¿Pertenece a un consultorio?"}
        permisos_miembro_alt["Abrir Mis turnos. Registrarse por la web no crea una membresía de<br/>equipo."]
        permisos_miembro -->|No| permisos_miembro_alt
        permisos_miembro_alt --> reservas_portal
        permisos_centro["Seleccionar consultorio activo — Si tiene más de uno, usar el<br/>selector. Los datos y permisos se cargan para ese consultorio."]
        permisos_rol["Aplicar el rol de la membresía — Administrador: equipo y<br/>configuración. Profesional: agenda con gestión de sus turnos y<br/>fichas autorizadas. Recepción: pacientes y agenda."]
        permisos_clinico{"¿Tiene permiso clínico?"}
        permisos_clinico_alt["Inicio administrativo con acceso a pacientes y agenda. Sin<br/>contenido de historias clínicas."]
        permisos_clinico -->|No| permisos_clinico_alt
        permisos_clinico_alt --> pacientes_directorio
        permisos_alcance["Comprobar especialidad y alcance — Lectura, escritura y<br/>exportación por separado. Alcance: todas las fichas de la<br/>especialidad o solo asignadas/creadas."]
        permisos_inicio(["Mostrar Inicio y módulos autorizados — Con acceso clínico:<br/>resumen de historias/evoluciones, búsqueda, últimas fichas y<br/>planillas vacías. El menú se ajusta a sus permisos."])
        permisos_membresias --> permisos_miembro
        permisos_miembro -->|Sí| permisos_centro
        permisos_centro --> permisos_rol
        permisos_rol --> permisos_clinico
        permisos_clinico -->|Sí| permisos_alcance
        permisos_alcance --> permisos_inicio
    end
    subgraph PACIENTES["03 · Directorio de pacientes"]
        direction TB
        pacientes_directorio(["Abrir Pacientes — Buscar por nombre, DNI o número de historia y<br/>navegar los resultados."])
        pacientes_existe{"¿El paciente ya está registrado?"}
        pacientes_existe_alt["Agregar paciente con datos administrativos y contacto."]
        pacientes_existe -->|No| pacientes_existe_alt
        pacientes_existe_alt --> pacientes_datos
        pacientes_editar["Seleccionar paciente → Editar datos — Abrir sus datos<br/>administrativos. Esto no abre automáticamente su historia<br/>clínica."]
        pacientes_datos["Completar o actualizar identificación — Nombre, DNI opcional,<br/>número de historia, nacimiento, domicilio, teléfonos, obra<br/>social, ocupación y contacto de emergencia."]
        pacientes_valido{"¿Datos válidos y sin duplicados?"}
        pacientes_valido_alt["Corregir formato, fechas o DNI/número de historia duplicado. Si<br/>otra sesión cambió los datos, recargar antes de editar."]
        pacientes_valido -->|No| pacientes_valido_alt
        pacientes_valido_alt --> pacientes_datos
        pacientes_guardar["Guardar identidad administrativa — Persistir la nueva versión y<br/>actualizar el directorio."]
        pacientes_ficha{"¿Puede abrir o crear una ficha?"}
        pacientes_ficha_alt["Continuar con datos administrativos y agenda, sin acceder a<br/>información clínica."]
        pacientes_ficha -->|No| pacientes_ficha_alt
        pacientes_ficha_alt --> agenda_abrir
        pacientes_abrirficha(["Abrir / Crear ficha de podología u odontología — Reutilizar la misma<br/>identidad del paciente para cada ficha autorizada."])
        pacientes_directorio --> pacientes_existe
        pacientes_existe -->|Sí| pacientes_editar
        pacientes_editar --> pacientes_datos
        pacientes_datos --> pacientes_valido
        pacientes_valido -->|Sí| pacientes_guardar
        pacientes_guardar --> pacientes_ficha
        pacientes_ficha -->|Sí| pacientes_abrirficha
    end
    subgraph HISTORIAS["04 · Historia clínica y evoluciones"]
        direction TB
        historias_buscar(["Buscar una historia o crear una ficha — Desde Inicio, Historias<br/>clínicas o la ficha del directorio administrativo."])
        historias_modulo{"¿Especialidad instalada y lectura autorizada?"}
        historias_modulo_alt["Mostrar falta de permiso o especialidad no disponible. No cargar<br/>contenido clínico."]
        historias_modulo -->|No| historias_modulo_alt
        historias_cargar["Cargar ficha existente o identidad del paciente — Una ficha nueva<br/>puede reutilizar un paciente administrativo existente. Una ficha<br/>existente carga su versión guardada."]
        historias_escribir{"¿Tiene permiso para modificar esta ficha?"}
        historias_escribir_alt["Consulta en modo lectura. PDF y versiones solo si tiene permiso<br/>de exportación."]
        historias_escribir -->|No| historias_escribir_alt
        historias_escribir_alt --> documentos_permiso
        historias_hojauno["Hoja 1 · Datos y antecedentes — Fecha de apertura,<br/>identificación, antecedentes, vacunas, tratamientos, medicación,<br/>hábitos y autorización para fotografías."]
        historias_hojados["Hoja 2 · Evoluciones — Presión, glucemia, peso, talla, IMC<br/>calculado, observaciones y consultas con fecha y procedimiento."]
        historias_validar{"¿Ficha y consultas válidas?"}
        historias_validar_alt["Mostrar errores y llevar al campo y hoja correspondientes.<br/>Corregir y volver a guardar."]
        historias_validar -->|No| historias_validar_alt
        historias_validar_alt --> historias_hojauno
        historias_version{"¿La versión sigue vigente?"}
        historias_version_alt["Otra sesión modificó la ficha o identidad. No sobrescribir;<br/>recargar la versión guardada y revisar los cambios."]
        historias_version -->|No| historias_version_alt
        historias_version_alt --> historias_cargar
        historias_guardada(["Guardar ficha y nueva versión histórica — Actualizar la historia<br/>del consultorio y conservar una copia del guardado."])
        historias_buscar --> historias_modulo
        historias_modulo -->|Sí| historias_cargar
        historias_cargar --> historias_escribir
        historias_escribir -->|Podología| historias_hojauno
        historias_escribir -->|Odontología| dental_antecedentes
        historias_hojauno --> historias_hojados
        historias_hojados --> historias_validar
        historias_validar -->|Sí| historias_version
        historias_version -->|Sí| historias_guardada
    end
    subgraph ODONTOLOGIA["04b · Ficha odontológica de adultos y niños"]
        dental_antecedentes["Ficha inicial: motivo, alergias, medicación y antecedentes"]
        dental_control["Continuar el último odontograma: elegir dentición permanente, temporal o mixta"]
        dental_pintar["Elegir pieza y pintar caras: rojo/caries, azul/resina, negro/amalgama.<br/>Leyenda, símbolos, detalle, borrar por cara y deshacer"]
        dental_plan["Plan: pendiente, en curso o realizado; evoluciones fechadas"]
        dental_guardar["Validar y guardar con autor del servidor y versión concurrente"]
        dental_lectura["Continuar el estado actual o consultar el historial en lectura,<br/>conservando cada guardado anterior"]
        dental_pdf["Revalidar autorización: PDF actual o versión anterior,<br/>con colores, leyenda, controles, plan y evoluciones"]
        dental_antecedentes --> dental_control --> dental_pintar --> dental_plan --> dental_guardar
        dental_guardar --> historias_validar
        historias_guardada -.-> dental_lectura
        dental_lectura --> dental_control
        dental_lectura --> dental_pdf
    end
    subgraph DOCUMENTOS["05 · PDF, planillas y versiones"]
        direction TB
        documentos_origen(["Elegir qué imprimir o descargar — Planilla vacía desde Inicio<br/>clínico, documento actual de un paciente o una versión histórica."])
        documentos_vacia{"¿Es una planilla vacía?"}
        documentos_vacia_alt["Desde Inicio clínico, elegir el tipo de planilla y generar PDF<br/>sin datos de un paciente."]
        documentos_vacia -->|Sí| documentos_vacia_alt
        documentos_vacia_alt --> documentos_generar
        documentos_permiso{"¿Tiene permiso de exportación?"}
        documentos_permiso_alt["No habilitar PDF ni descarga de versiones clínicas."]
        documentos_permiso -->|No| documentos_permiso_alt
        documentos_origenversion["Elegir ficha actual o versión anterior — Actual: guardar los<br/>cambios antes de descargar. Historial: seleccionar una de las<br/>últimas 30 versiones disponibles."]
        documentos_revalidar["Revalidar acceso y versión en el servidor — Para la ficha actual,<br/>comprobar que no haya cambiado desde que se abrió. Para una<br/>versión, obtener su copia autorizada."]
        documentos_tipo["Seleccionar contenido — Historia completa, ficha inicial,<br/>evoluciones registradas o evolución vacía para completar en<br/>papel."]
        documentos_generar(["Generar y descargar PDF — Documento con los datos del consultorio<br/>y la plantilla de podología. Firma a completar en papel."])
        documentos_origen --> documentos_vacia
        documentos_vacia -->|No| documentos_permiso
        documentos_permiso -->|Sí| documentos_origenversion
        documentos_origenversion --> documentos_revalidar
        documentos_revalidar --> documentos_tipo
        documentos_tipo --> documentos_generar
    end
    subgraph AGENDA["06 · Agenda, turnos manuales y bloqueos"]
        direction TB
        agenda_abrir(["Abrir Agenda — Elegir día o semana, filtrar profesional si hay<br/>varias y consultar los turnos."])
        agenda_accion{"¿Quiere bloquear un horario?"}
        agenda_accion_alt["Bloquear horario → profesional, Desde, Hasta y motivo opcional.<br/>Validar duración y superposiciones; guardar bloqueo."]
        agenda_accion -->|Sí| agenda_accion_alt
        agenda_accion_alt --> agenda_bloqueado
        agenda_nuevo["Nuevo turno / Agregar turno desde un día — La fecha del día<br/>elegido queda cargada. Si hay una sola profesional elegible, se<br/>selecciona automáticamente."]
        agenda_paciente["Identificar al paciente — Buscar un paciente administrativo o<br/>completar nombre y DNI. Opcional: seleccionar expresamente una<br/>cuenta verificada del portal."]
        agenda_horario["Elegir prestación, profesional, día y duración — Seleccionar un<br/>horario sugerido o escribir otra hora. Revisar el horario de<br/>finalización. Contacto y notas opcionales."]
        agenda_validar{"¿Datos válidos y horario libre?"}
        agenda_validar_alt["Corregir campos, duración, superposición o el límite de un turno<br/>futuro por paciente/profesional."]
        agenda_validar -->|No| agenda_validar_alt
        agenda_validar_alt --> agenda_horario
        agenda_guardar["Guardar y volver a comprobar en el servidor — Comprobar permisos,<br/>identidad, ocupación y límite de reservas. Si otra sesión ocupó<br/>la hora, elegir otra."]
        agenda_seguimiento(["Turno confirmado → seguimiento — Abrir para editar, cambiar<br/>horario/duración, cancelar, marcar atendido o ausente.<br/>Atendido/ausente se habilita cuando el turno ya no es futuro."])
        agenda_bloqueado(["Bloqueo guardado — Ocupa el horario y lo excluye de las reservas.<br/>Editar el intervalo o cancelar el bloqueo para liberar el<br/>horario."])
        agenda_abrir --> agenda_accion
        agenda_accion -->|No| agenda_nuevo
        agenda_nuevo --> agenda_paciente
        agenda_paciente --> agenda_horario
        agenda_horario --> agenda_validar
        agenda_validar -->|Sí| agenda_guardar
        agenda_guardar --> agenda_seguimiento
    end
    subgraph RESERVAS["07 · Reservas públicas y portal del paciente"]
        direction TB
        reservas_enlace(["Abrir enlace público o listado de agendas — Elegir la atención<br/>disponible. Los enlaces antiguos se resuelven como alias cuando<br/>se renombra una agenda."])
        reservas_abierta{"¿Agenda abierta y prestación activa?"}
        reservas_abierta_alt["Mostrar agenda cerrada o no encontrada. Consultar otras agendas o<br/>contactar al consultorio."]
        reservas_abierta -->|No| reservas_abierta_alt
        reservas_cuenta["Consultar horarios e ingresar a la cuenta — Puede ver<br/>disponibilidad como visitante. Para confirmar necesita email<br/>verificado y perfil de paciente con nombre y DNI."]
        reservas_duplicado{"¿Ya tiene un turno futuro con esa profesional?"}
        reservas_duplicado_alt["Ir a Mis turnos. Reprogramar o cancelar el turno existente en<br/>lugar de crear otro."]
        reservas_duplicado -->|Sí| reservas_duplicado_alt
        reservas_duplicado_alt --> reservas_portal
        reservas_elegir["Elegir día y horario — Respetar franjas, duración de la<br/>prestación, anticipación mínima/máxima y ocupación. Sin horarios:<br/>cambiar de fecha."]
        reservas_confirmar["Confirmar reserva — El servidor verifica otra vez identidad,<br/>reglas, disponibilidad y límite de reservas."]
        reservas_valida{"¿La reserva se pudo guardar?"}
        reservas_valida_alt["Mostrar el motivo; corregir datos o elegir un nuevo horario y<br/>reintentar."]
        reservas_valida -->|No| reservas_valida_alt
        reservas_valida_alt --> reservas_elegir
        reservas_portal["Mis turnos — Ver turnos futuros e historial, estados y avisos por<br/>email. Mis datos permite editar nombre y celular; el DNI guardado<br/>no se cambia desde el portal."]
        reservas_plazo{"¿Turno confirmado y dentro del plazo de cambios?"}
        reservas_plazo_alt["Consultar el turno y contactar al consultorio para cambios. No<br/>habilitar acciones fuera de plazo."]
        reservas_plazo -->|No| reservas_plazo_alt
        reservas_gestion["Cancelar o reprogramar — Cancelar: confirmar para liberar<br/>horario. Reprogramar: elegir nuevo horario y confirmar, si la<br/>reserva permite reprogramación web."]
        reservas_actualizado(["Turno actualizado en Mis turnos — El cambio queda guardado aunque<br/>el email esté pendiente. Cerrar sesión al terminar."])
        reservas_enlace --> reservas_abierta
        reservas_abierta -->|Sí| reservas_cuenta
        reservas_cuenta --> reservas_duplicado
        reservas_duplicado -->|No| reservas_elegir
        reservas_elegir --> reservas_confirmar
        reservas_confirmar --> reservas_valida
        reservas_valida -->|Sí| reservas_portal
        reservas_portal --> reservas_plazo
        reservas_plazo -->|Sí| reservas_gestion
        reservas_gestion --> reservas_actualizado
    end
